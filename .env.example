# ==============================================================================
# TaskFlow PWA - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL Configuration
# ------------------------------------------------------------------------------
# Obtain from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Service role key is only used on the server (API routes / cron jobs). Never exposed to client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# 2. Firebase Cloud Messaging (Client-Side Web Push)
# ------------------------------------------------------------------------------
# Obtain from Firebase Console -> Project Settings -> General -> Your Apps (Web)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
# Web Push Certificate key pair (VAPID key) from Firebase Console -> Cloud Messaging -> Web configuration
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your-public-vapid-key

# ------------------------------------------------------------------------------
# 3. Firebase Admin SDK (Server-Side Notification Delivery)
# ------------------------------------------------------------------------------
# Obtain from Firebase Console -> Project Settings -> Service accounts -> Generate new private key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com
# Use escaped newlines (\n) when setting in environment variables or Vercel
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 4. Cron & Deployment Settings
# ------------------------------------------------------------------------------
# Optional secret token to protect /api/notifications/cron endpoint from unauthorized calls
CRON_SECRET=your-random-cron-secret-token
